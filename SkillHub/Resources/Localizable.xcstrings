        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même nom"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同名"
          }
        },
        "ko": {
          "stringUnit": {
